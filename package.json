{
  "name": "auto-tracking-angular",
  "version": "1.0.7",
  "private": false,
  "description": "Biblioteca Angular/Ionic para auto-tracking com análise causal, geração de tags e relatórios Excel/JSON",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "bin": {
    "auto-tracking": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "node node_modules/.bin/jest",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "release": "node scripts/release.mjs",
    "link": "npm link",
    "check": "npm run typecheck && npm run typecheck:test && npm run build && npm test -- --runInBand",
    "test:ci": "npm test -- --ci --runInBand",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run check",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "peerDependencies": {
    "@angular/common": ">=16.0.0",
    "@angular/core": ">=16.0.0",
    "@angular/router": ">=16.0.0",
    "@capacitor/app": ">=5.0.0",
    "@capacitor/core": ">=5.0.0",
    "@ionic/angular": ">=7.0.0",
    "typescript": ">=4.9.0"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    },
    "@ionic/angular": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^17.3.12",
    "@angular/core": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@ionic/angular": "^7.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pako": "2.0.3",
    "@types/pngjs": "^6.0.5",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.0.0",
    "typescript": "~5.2.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pako": "2.1.0",
    "pngjs": "^7.0.0"
  },
  "typesVersions": {
    "*": {
      "config": [
        "dist/config.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renanaribeiro91/auto-tracking-angular.git"
  },
  "homepage": "https://github.com/renanaribeiro91/auto-tracking-angular#readme",
  "bugs": {
    "url": "https://github.com/renanaribeiro91/auto-tracking-angular/issues"
  },
  "keywords": [
    "angular",
    "ionic",
    "auto-tracking",
    "analytics",
    "instrumentation",
    "typescript",
    "tagging",
    "cli",
    "xlsx"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
